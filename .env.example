# Public site URL (required in production for origin and Turnstile hostname validation)
NEXT_PUBLIC_SITE_URL=https://marinathiago.vercel.app
# Public media custom domain; leave blank for local optimized variants
NEXT_PUBLIC_MEDIA_URL=
# Server-only Supabase credentials (never use NEXT_PUBLIC_ or anon key for guestbook)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback if your project uses service_role key naming
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile: client site key / server secret, configured for your deployed hostname
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random server-only secret, at least 32 bytes (used to hash visitor IPs for rate limiting)
RATE_LIMIT_SECRET=
# Enable only behind Cloudflare with direct access to the origin blocked
TRUST_CLOUDFLARE_PROXY=false
# Ingestion only — never NEXT_PUBLIC
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_ORIGINALS_BUCKET=
# Optional absolute directory of original photographs
PHOTO_SOURCE_DIR=

